# Copy this file to ".env" and fill in your real value for LOCAL testing only.
# Never commit the real ".env" file — make sure .gitignore includes it.
# This is separate from the root .env used by app.py — a fresh copy of the
# same token value, not a shared file.
# On Render, set this same name as an Environment Variable in the dashboard.

HUGGINGFACEHUB_API_TOKEN=your-hugging-face-access-token-here